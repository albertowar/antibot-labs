{
  "title": "Capstone — Signal Health",
  "uid": "capstone-signal-health",
  "schemaVersion": 39,
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries", "title": "Layer trigger counts", "id": 1,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "lab_layer_triggers_total", "legendFormat": "{{layer}}"}]
    },
    {
      "type": "timeseries", "title": "Decisions by outcome", "id": 2,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "sum by (outcome) (lab_decisions_total)", "legendFormat": "{{outcome}}"}]
    },
    {
      "type": "stat", "title": "WebSocket floods cut", "id": 3,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 9},
      "targets": [{"expr": "lab_ws_flood_events_total"}]
    },
    {
      "type": "stat", "title": "CSP violations", "id": 4,
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 9},
      "targets": [{"expr": "lab_csp_violations_total"}]
    },
    {
      "type": "stat", "title": "DEFENSE_LEVEL", "id": 5,
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 9},
      "targets": [{"expr": "lab_defense_level"}]
    }
  ]
}
