{
  "version": 1,
  "rules": [
    {
      "description": "asset-less scripted pacing on a hosting network",
      "action": "block",
      "when": {
        "all": [
          {
            "field": "n_assets",
            "op": "lte",
            "value": 0
          },
          {
            "field": "asn_type",
            "op": "eq",
            "value": "datacenter"
          },
          {
            "field": "median_gap_s",
            "op": "lte",
            "value": 36.5
          }
        ]
      },
      "source": {
        "cluster": "datacenter|firefox|m|normal|p4|a0|-|///p",
        "drafted_by": "mock:scripted-analyst",
        "run": "checkpoint",
        "cluster_size": 40
      },
      "id": "r-0fc2fb"
    },
