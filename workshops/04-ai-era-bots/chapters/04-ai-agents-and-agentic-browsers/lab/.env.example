# Copy to .env and `set -a; . ./.env; set +a` (or export by hand). Unset = zero-Docker defaults.
PORT=5000
DEFENSE_LEVEL=0
#REDIS_URL=redis://127.0.0.1:6379/0
#DATABASE_URL=postgresql+psycopg://workshop:workshop@127.0.0.1:5432/shop
LAB_SEED=1337
LAB_HEADERS=1
LAB_SHADOW=0
#LAB_SHADOW_CHECKS=automation,fingerprint
LAB_RELOAD=1
DROP_STOCK=50
# Client side (attacks, tools): where the store is. Must be this machine.
DEMO_URL=http://127.0.0.1:5000
# The agent operators' websites (their signed key directories): a side service on this machine.
# The store starts it on a thread at MOCK_URL unless one already answers; MOCK_AUTOSTART=0 to run
# `python tools/mock_internet.py` in its own terminal. A busy port falls back to a free one.
MOCK_URL=http://127.0.0.1:5004
#MOCK_AUTOSTART=0
# The agents drive a real Chromium: HEADLESS=1 forces headless (no display), HEADLESS=0 shows the browser.
#HEADLESS=1
# Optional: a local open model decides the agent's actions instead of the scripted planner (OLLAMA_URL must be this machine).
#AGENT_POLICY=ollama
#OLLAMA_URL=http://127.0.0.1:11434
