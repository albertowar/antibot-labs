# Copy to .env and `set -a; . ./.env; set +a` (or export by hand). Unset = zero-Docker defaults.
PORT=5000
DEFENSE_LEVEL=0
#REDIS_URL=redis://127.0.0.1:6379/0
#DATABASE_URL=postgresql+psycopg://workshop:workshop@127.0.0.1:5432/shop
LAB_SEED=1337
LAB_HEADERS=1
LAB_SHADOW=0
#LAB_SHADOW_CHECKS=automation,fingerprint
LAB_RELOAD=1
# A drop day sells thousands of units (the checkpoint resets the store with 20000):
DROP_STOCK=20000
# Simulated think time is scaled by this; the features divide measured gaps by it. Change it and retrain.
LAB_TIME_SCALE=0.02
# Client side (attacks, tools): where the store is. Must be this machine.
DEMO_URL=http://127.0.0.1:5000
